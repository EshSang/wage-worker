generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Earning {
  id                            Int            @id @default(autoincrement())
  jobApplicationId              Int
  jobId                         Int
  workerId                      Int
  customerId                    Int
  amount                        Int
  earnedDate                    DateTime       @default(now()) @db.DateTime(0)
  paymentGatewayId              String?        @db.VarChar(255)
  status                        String         @default("COMPLETED") @db.VarChar(50)
  orderId                       Int?           @unique(map: "Earning_orderId_key")
  customer                      User           @relation("Earning_customerIdToUser", fields: [customerId], references: [id], map: "Earning_customerId_fkey")
  jobApplication                JobApplication @relation(fields: [jobApplicationId], references: [id], map: "Earning_jobApplicationId_fkey")
  job                           Job            @relation(fields: [jobId], references: [id], map: "Earning_jobId_fkey")
  order                         Order?         @relation(fields: [orderId], references: [id], map: "Earning_orderId_fkey")
  worker                        User           @relation("Earning_workerIdToUser", fields: [workerId], references: [id], map: "Earning_workerId_fkey")

  @@index([customerId, earnedDate], map: "Earning_customerId_earnedDate_idx")
  @@index([jobApplicationId], map: "Earning_jobApplicationId_fkey")
  @@index([jobId], map: "Earning_jobId_idx")
  @@index([workerId, earnedDate], map: "Earning_workerId_earnedDate_idx")
  @@map("earning")
}

model Job {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(255)
  description     String           @db.VarChar(1000)
  skills          String           @db.VarChar(255)
  location        String           @db.VarChar(255)
  postedDate      DateTime         @db.Date
  hourlyRate      Int
  status          String           @db.VarChar(50)
  createdUserId   Int
  categoryId      Int
  jobType         String           @default("PUBLIC") @db.VarChar(50)
  targetWorkerId  Int?
  earnings        Earning[]
  category        JobCategory      @relation(fields: [categoryId], references: [id], map: "Job_categoryId_fkey")
  createdUser     User             @relation("Job_createdUser", fields: [createdUserId], references: [id], map: "Job_createdUserId_fkey")
  targetWorker    User?            @relation("Job_targetWorker", fields: [targetWorkerId], references: [id], map: "Job_targetWorkerId_fkey")
  jobApplications JobApplication[]
  orders          Order[]

  @@index([categoryId], map: "Job_categoryId_fkey")
  @@index([createdUserId], map: "Job_createdUserId_fkey")
  @@index([targetWorkerId], map: "Job_targetWorkerId_fkey")
  @@map("job")
}

model JobApplication {
  id                Int        @id @default(autoincrement())
  jobId             Int
  userId            Int
  appliedDate       DateTime   @db.Date
  applicationStatus JobStatus  @default(APPLIED)
  applicationType   String     @default("MANUAL") @db.VarChar(50)
  earnings          Earning[]
  job               Job        @relation(fields: [jobId], references: [id], map: "JobApplication_jobId_fkey")
  user              User       @relation(fields: [userId], references: [id], map: "JobApplication_userId_fkey")
  orders            Order[]

  @@index([jobId], map: "JobApplication_jobId_fkey")
  @@index([userId], map: "JobApplication_userId_fkey")
  @@map("jobapplication")
}

model JobCategory {
  id       Int    @id @default(autoincrement())
  category String @db.VarChar(50)
  jobs     Job[]

  @@map("jobcategory")
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  type        NotificationType
  title       String           @db.VarChar(255)
  message     String           @db.VarChar(1000)
  relatedId   Int?
  relatedType String?          @db.VarChar(50)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.DateTime(0)
  user        User             @relation(fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([createdAt], map: "Notification_createdAt_idx")
  @@index([userId, isRead], map: "Notification_userId_isRead_idx")
  @@map("notification")
}

model Order {
  id                      Int            @id @default(autoincrement())
  jobApplicationId        Int
  jobId                   Int
  userId                  Int
  acceptedDate            DateTime       @db.Date
  startedDate             DateTime?      @db.Date
  completedDate           DateTime?      @db.Date
  estimatedCompletionDate DateTime?      @db.Date
  status                  OrderStatus    @default(PENDING)
  earning                 Earning?
  jobApplication          JobApplication @relation(fields: [jobApplicationId], references: [id], map: "Order_jobApplicationId_fkey")
  job                     Job            @relation(fields: [jobId], references: [id], map: "Order_jobId_fkey")
  user                    User           @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  reviews                 Review[]

  @@index([jobApplicationId], map: "Order_jobApplicationId_fkey")
  @@index([jobId], map: "Order_jobId_fkey")
  @@index([userId], map: "Order_userId_fkey")
  @@map("order")
}

model Review {
  id          Int       @id @default(autoincrement())
  orderId     Int
  reviewerId  Int
  rating      Int
  comment     String    @db.VarChar(1000)
  workerReply String?   @db.VarChar(1000)
  repliedAt   DateTime? @db.Date
  createdAt   DateTime  @db.Date
  order       Order     @relation(fields: [orderId], references: [id], map: "Review_orderId_fkey")
  reviewer    User      @relation(fields: [reviewerId], references: [id], map: "Review_reviewerId_fkey")

  @@index([orderId], map: "Review_orderId_fkey")
  @@index([reviewerId], map: "Review_reviewerId_fkey")
  @@map("review")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique(map: "User_email_key") @db.VarChar(255)
  password        String           @db.VarChar(255)
  fname           String           @db.VarChar(255)
  lname           String           @db.VarChar(255)
  phonenumber     String?          @db.VarChar(20)
  address         String?          @db.VarChar(255)
  skills          String?          @db.VarChar(255)
  about           String?          @db.VarChar(500)
  usertype        UserType         @default(USER)
  paymentsGiven   Earning[]        @relation("Earning_customerIdToUser")
  earnings        Earning[]        @relation("Earning_workerIdToUser")
  jobs            Job[]            @relation("Job_createdUser")
  directHireJobs  Job[]            @relation("Job_targetWorker")
  jobApplications JobApplication[]
  notifications   Notification[]
  orders          Order[]
  reviews         Review[]

  @@map("user")
}

enum NotificationType {
  ORDER_ACCEPTED
  ORDER_STARTED
  ORDER_COMPLETED
  PAYMENT_RECEIVED
  FEEDBACK_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  JOB_APPLIED
  REVIEW_RECEIVED

  @@map("notification_type")
}

enum JobStatus {
  PENDING
  APPLIED
  ACCEPTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED

  @@map("jobapplication_applicationStatus")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum UserType {
  USER
  ADMIN
  REVIEWER

  @@map("user_usertype")
}
